# =============================================================================
# JobForge — environment configuration
#
# Copy this file to `.env` at the repository root and fill in real values:
#
#     cp .env.example .env        (macOS / Linux)
#     Copy-Item .env.example .env (Windows PowerShell)
#
# `.env` is git-ignored. NEVER commit real credentials.
#
# Only the variables prefixed with VITE_ are readable by the browser. Everything
# else stays on the server — the Resend key and the MongoDB URI must never be
# given a VITE_ prefix, because Vite inlines those into the public JS bundle.
# =============================================================================


# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# development | test | production
#
# DO NOT set this as an environment variable on Vercel. npm reads NODE_ENV during
# `npm install`, and `production` makes it skip devDependencies — which strips out
# TypeScript, Vite and tsx, so the build fails. Vercel sets NODE_ENV=production for
# the function runtime by itself, and the server falls back to VERCEL_ENV anyway.
NODE_ENV=development

# Port for the local Express server. Ignored on Vercel (serverless).
PORT=5000

# MongoDB connection string, e.g. from MongoDB Atlas.
#
# Required in every environment, not only production. Storage started out backing one
# thing — the contact form — and now backs accounts, projects and the owner console, so
# leaving this unset does not degrade the site, it stops sign-in: every database-backed
# endpoint answers a clear 503 rather than pretending anything succeeded. If signing in
# returns "We cannot reach our records right now", this is the variable to check first.
MONGODB_URI=mongodb://127.0.0.1:27017/jobforge

# Optional. Overrides the database name embedded in MONGODB_URI.
# MONGODB_DB_NAME=jobforge

# Resend API key (https://resend.com/api-keys). Starts with `re_`.
# Required when NODE_ENV=production.
RESEND_API_KEY=re_replace_me

# The "from" address Resend sends notifications as. Must be an address on a
# domain you have verified in Resend, otherwise delivery fails.
# Resend's onboarding@resend.dev works for testing but can only send to the
# email address that owns the Resend account.
RESEND_FROM_EMAIL=Website Leads <leads@example.com>

# Where new lead notifications are delivered. This is your inbox.
# Required when NODE_ENV=production.
CONTACT_NOTIFICATION_EMAIL=owner@example.com

# Where the PlayBook workbook PDF is hosted.
#
# This is the switch on automatic delivery. Set it and a subscriber is emailed the link
# as soon as they ask; leave it unset and the request is stored and the owner is notified
# to send it by hand. Both are working flows — what the site must never do is claim an
# email is on its way when nothing is sending one, so the confirmation copy is chosen
# from whether this is set.
#
# Produce the PDF by opening /playbook/workbook and printing to PDF, then host the file
# and put its URL here.
# PLAYBOOK_PDF_URL=https://www.example.com/service-business-website-playbook.pdf

# Comma-separated list of browser origins allowed to call the API.
#
# There are two frontends: the customer application (apps/client) and the owner console
# (apps/admin). Deployed to separate origins, BOTH must be listed here:
#
#   CLIENT_ORIGIN=https://www.example.com,https://admin.example.com
#
# Leave unset in development — both dev servers proxy /api to Express, so the browser
# makes same-origin requests and no CORS headers are involved. Leave unset in production
# too if both apps are served from the same origin as the API.
#
# NEVER set this to `*`. These requests carry the session cookie; a wildcard would let any
# page on the internet make authenticated calls as a signed-in user.
# CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174

# -----------------------------------------------------------------------------
# Stripe billing (all optional — without these the site runs exactly as before,
# and the billing endpoints answer 503 with an instruction)
#
# NEVER give any of these a VITE_ prefix: Vite inlines VITE_ variables into the
# public JS bundle, and these are server-side credentials.
#
# Setup, in order (see README "Stripe setup" for the walkthrough):
#   1. Create the products/prices in the Stripe dashboard and paste their price IDs.
#   2. Add a webhook endpoint pointing at https://<your-domain>/api/billing/webhook
#      subscribed to: checkout.session.completed,
#      checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
#      invoice.paid, invoice.payment_failed, customer.subscription.created,
#      customer.subscription.updated, customer.subscription.deleted,
#      payment_intent.payment_failed, charge.refunded.
#   3. Generate a long random BILLING_ADMIN_TOKEN — it is the owner's key to the
#      project/checkout-link endpoints.
# -----------------------------------------------------------------------------

# Secret API key (https://dashboard.stripe.com/apikeys). Starts with `sk_test_` in
# Sandbox/Test Mode and `sk_live_` in live mode — start with the test key, and keep
# test and live values in separate environments (local .env vs Vercel production).
# Prefer a restricted key (`rk_`) scoped to Checkout Sessions, Prices (read) and
# Billing Portal over the full secret key.
# STRIPE_SECRET_KEY=sk_test_replace_me

# Publishable key (starts with `pk_`). NOT currently used: payments run through
# Stripe-hosted Checkout links, so the browser never talks to Stripe directly. Listed
# here so that if embedded payment elements are ever added, the key that is safe to
# expose is already distinguished from the two above that never are.
# STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Webhook signing secret for the endpoint above. Starts with `whsec_`.
# STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Bearer token for the owner-only billing endpoints (POST /api/billing/projects,
# POST /api/billing/checkout-sessions, ...). Long and random; treat like a password.
# BILLING_ADMIN_TOKEN=replace_with_a_long_random_string

# Stripe Price IDs, one per product. `npm run stripe:setup --workspace server`
# creates (or verifies) the whole catalog idempotently and prints these lines:
#   Build deposit        — one-time, half the project price
#   Launch payment       — one-time, the other half
#   Growth Partner       — recurring monthly
#   Growth Partner (yr)  — recurring yearly prepay
# STRIPE_PRICE_BUILD_DEPOSIT=price_replace_me
# STRIPE_PRICE_BUILD_FINAL=price_replace_me
# STRIPE_PRICE_GROWTH_PARTNER_MONTHLY=price_replace_me
# STRIPE_PRICE_GROWTH_PARTNER_ANNUAL=price_replace_me
#
# Reserved for the founding→standard transition (see docs/stripe-pricing-transition.md);
# nothing reads these yet:
# STRIPE_PRICE_BUILD_DEPOSIT_STANDARD=
# STRIPE_PRICE_BUILD_FINAL_STANDARD=

# Public origin for Stripe Checkout redirect URLs (success lands on /welcome).
# Falls back to VITE_SITE_URL when unset.
# PUBLIC_SITE_URL=https://www.example.com


# -----------------------------------------------------------------------------
# Accounts and Google sign-in
# -----------------------------------------------------------------------------
#
# Everything here is optional. Without it, email-and-password accounts work exactly as
# normal and the "Continue with Google" button still renders — it explains that Google
# sign-in is not set up on this deployment rather than failing. That is the intended
# local-development state; see docs/GOOGLE-SIGN-IN.md.
#
# There is deliberately NO client secret. The Google Identity Services flow returns a
# signed ID token to the browser, which the server verifies against Google's published
# public keys — no token exchange happens, so no secret exists to leak. If you find
# yourself adding GOOGLE_CLIENT_SECRET here, something has gone wrong.

# The OAuth 2.0 **Web application** client id from Google Cloud. Public by design: it
# ships to the browser either way. It is served from /api/auth/config rather than
# inlined at build time, so one build can be deployed against a development client and
# a production client without rebuilding.
#
# Development and production need SEPARATE clients, because a client's authorised
# JavaScript origins are exact:
#
#   Development client → Authorised JavaScript origins: http://localhost:5173
#   Production client  → Authorised JavaScript origins: https://www.example.com
#
# No redirect URI is required for this flow. Google Identity Services posts the
# credential back to the page that requested it.
# GOOGLE_CLIENT_ID=000000000000-abcdefghijklmnop.apps.googleusercontent.com

# Per-IP throttle on the credential endpoints: sign in, sign up, password reset and the
# Google exchange. Tighter than the lead limit because every request it covers is an
# attempt to guess a secret. Successful sign-ins do not count against it.
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=20


# -----------------------------------------------------------------------------
# Admin provisioning
# -----------------------------------------------------------------------------
# Read by ONE thing: `npm run admin:create --workspace server`. The running application
# never loads either of these — they are deliberately absent from `src/config/env.ts`, so
# no service, handler or error response can reach them.
#
# What the script does with them: creates the account with the `admin` role if it does not
# exist, or promotes an existing account to `admin`. It never overwrites a password unless
# you pass `--reset-password`, and it refuses the placeholders below.
#
#     npm run admin:create --workspace server -- --check    # report, change nothing
#
# RULES, and every one of them matters:
#
#   * NEVER give either of these a VITE_ prefix. Vite inlines VITE_ variables into the
#     public bundle, so a VITE_ADMIN_PASSWORD is a password published to every visitor.
#   * NEVER commit real values. `.env` and `.env.*` are gitignored; `.env.example` (this
#     file) is the only one tracked, and it must only ever contain placeholders.
#   * Production credentials are configured independently, in the production environment.
#     Do not reuse a development password there.
#   * Once the account exists, you can delete both lines from your local `.env`. The role
#     lives on the user document; nothing at runtime re-reads these.
#   * The password minimum is the same one customers are held to — currently 12 characters.
#     An admin must not be the weakest account in the system.
#
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=replace_with_a_long_random_password


# -----------------------------------------------------------------------------
# Deployment tracking (Vercel)
# -----------------------------------------------------------------------------
#
# Optional. Without it the deployment webhook answers 503 and preview URLs are set by
# hand from the admin endpoints — a working flow rather than a broken one.
#
# With it, every Vercel deployment carrying `jobforgeProjectId` in its metadata updates
# the matching customer's dashboard by itself: preview URL, production URL, and the
# milestone that goes with them.
#
# This is the integration's **client secret**, used to verify the HMAC-SHA1 signature on
# every delivery. It must never gain a VITE_ prefix: it is the only thing stopping
# anybody on the internet setting the URL a client is told is their website.
#
# Webhook endpoint to register with Vercel: https://www.example.com/api/deployments/webhook
# Events: deployment.created, deployment.succeeded, deployment.error, deployment.canceled
# VERCEL_WEBHOOK_SECRET=replace_with_the_integration_client_secret


# -----------------------------------------------------------------------------
# Scheduled work — the owner's daily digest
# -----------------------------------------------------------------------------
#
# The shared secret Vercel Cron presents as `Authorization: Bearer $CRON_SECRET` on every
# scheduled invocation of the job declared in `vercel.json`.
#
# WHAT IT TURNS ON: the once-a-day summary of everything judged not worth interrupting the
# owner for — new accounts, completed tasks, client comments. Every notification a *customer*
# receives is immediate and is completely unaffected by this.
#
# UNSET IS A SUPPORTED STATE, and it is the safe one. Without this the route is not mounted at
# all: `/api/cron/digest` is a genuine 404 rather than an endpoint anybody on the internet can
# call to drain the queue at 3am. Queued lines then expire on their own seven-day TTL.
#
# Generate one that is not guessable and never reuse BILLING_ADMIN_TOKEN for it:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
#
# NEVER give this a VITE_ prefix. It is a credential, and Vite inlines VITE_ variables into the
# public bundle.
# CRON_SECRET=replace_with_32_random_bytes


# -----------------------------------------------------------------------------
# File storage — Vercel Blob
# -----------------------------------------------------------------------------
#
# WHAT IT TURNS ON: uploads, in both directions. A client sending their logo and photographs;
# the owner sending back a proposal, an invoice or a report.
#
# UNSET IS A DEGRADED STATE, not a safe one — and this is the one place on this page where
# that is true. Two of the five onboarding tasks seeded on the day somebody pays are requests
# for files (`upload-logo`, `upload-photos`), and the build waits on the last of them. Without
# a store the file routes answer 503 with an instruction, the customer cannot answer either
# task in the portal, and the work stops until somebody emails the files instead.
#
# HOW TO GET ONE: Vercel dashboard → Storage → Create a Blob store → link it to this project.
# Vercel then injects this variable into every deployment automatically; copy it into `.env`
# for local development with `vercel env pull`.
#
# NEVER give this a VITE_ prefix. This token can overwrite and delete every file in the store.
# What the browser is handed is a *client token* minted from it on the server, scoped to one
# path, one content type, one size and one minute — see `features/files/file.service.ts`. That
# asymmetry is what lets a 12 MB photo go straight from a phone to the store without passing
# through a serverless function with a 4.5 MB body limit.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace_me


# debug | info | warn | error | silent
LOG_LEVEL=info

# Anti-abuse limits for POST /api/leads (per IP).
LEAD_RATE_LIMIT_WINDOW_MINUTES=15
LEAD_RATE_LIMIT_MAX=5


# -----------------------------------------------------------------------------
# Client (exposed to the browser — safe values only)
# -----------------------------------------------------------------------------

# Base URL for API calls. Leave empty for same-origin deployments; both dev servers
# proxy /api to PORT above, and on Vercel the customer application is served from the
# same domain as the API. Set it only when the API is on a different domain.
#
# Both frontends read this one name, so a local .env sets it once for both. In production
# they are separate Vercel projects and hold different values: empty on the customer
# project, and the API's origin on the console project — the console is on its own domain,
# so an empty base makes it fetch itself. See apps/admin/DEPLOY.md.
VITE_API_BASE_URL=

# Canonical public origin, used for canonical tags, Open Graph URLs and sitemap.xml.
VITE_SITE_URL=http://localhost:5173
