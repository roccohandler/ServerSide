# =============================================================================
# ServiceSide — environment configuration
#
# Copy this file to `.env` at the repository root and fill in real values:
#
#     cp .env.example .env        (macOS / Linux)
#     Copy-Item .env.example .env (Windows PowerShell)
#
# `.env` is git-ignored. NEVER commit real credentials.
#
# Only the variables prefixed with VITE_ are readable by the browser. Everything
# else stays on the server — the Resend key and the MongoDB URI must never be
# given a VITE_ prefix, because Vite inlines those into the public JS bundle.
# =============================================================================


# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# Port for the local Express server. Ignored on Vercel (serverless).
PORT=5000

# MongoDB connection string, e.g. from MongoDB Atlas.
# Required when NODE_ENV=production. Without it the lead endpoint returns a
# clear 503 instead of pretending a submission succeeded.
MONGODB_URI=mongodb://127.0.0.1:27017/serviceside

# Optional. Overrides the database name embedded in MONGODB_URI.
# MONGODB_DB_NAME=serviceside

# Resend API key (https://resend.com/api-keys). Starts with `re_`.
# Required when NODE_ENV=production.
RESEND_API_KEY=re_replace_me

# The "from" address Resend sends notifications as. Must be an address on a
# domain you have verified in Resend, otherwise delivery fails.
# Resend's onboarding@resend.dev works for testing but can only send to the
# email address that owns the Resend account.
RESEND_FROM_EMAIL=Website Leads <leads@example.com>

# Where new lead notifications are delivered. This is your inbox.
# Required when NODE_ENV=production.
CONTACT_NOTIFICATION_EMAIL=owner@example.com

# Comma-separated list of browser origins allowed to call the API.
# Leave unset for same-origin deployments (the default on Vercel).
# CLIENT_ORIGIN=http://localhost:5173,https://www.example.com

# debug | info | warn | error | silent
LOG_LEVEL=info

# Anti-abuse limits for POST /api/leads (per IP).
LEAD_RATE_LIMIT_WINDOW_MINUTES=15
LEAD_RATE_LIMIT_MAX=5


# -----------------------------------------------------------------------------
# Client (exposed to the browser — safe values only)
# -----------------------------------------------------------------------------

# Base URL for API calls. Leave empty for same-origin deployments; the Vite dev
# server proxies /api to PORT above, and on Vercel the API lives on the same
# domain. Set this only if the API is hosted on a different domain.
VITE_API_BASE_URL=

# Canonical public origin, used for canonical tags, Open Graph URLs and sitemap.xml.
VITE_SITE_URL=http://localhost:5173
