{
  "name": "jobforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Marketing site and lead capture for JobForge — digital growth systems for local service businesses in the Greater Seattle area.",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client,admin -c blue,green,magenta \"npm:dev:server\" \"npm:dev:client\" \"npm:dev:admin\"",
    "dev:client": "npm run dev --workspace @jobforge/client",
    "dev:admin": "npm run dev --workspace @jobforge/admin",
    "dev:server": "npm run dev --workspace @jobforge/server",
    "build": "npm run build:server && npm run build:web",
    "build:web": "npm run build:client && npm run build:admin && tsx scripts/place-console.ts",
    "build:client": "npm run build --workspace @jobforge/client",
    "build:admin": "npm run build --workspace @jobforge/admin",
    "build:server": "npm run build --workspace @jobforge/server",
    "start": "npm run start --workspace @jobforge/server",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "npm run typecheck --workspace @jobforge/server && npm run typecheck --workspace @jobforge/client && npm run typecheck --workspace @jobforge/admin && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:csp": "tsx scripts/check-csp.ts",
    "preflight": "npm run preflight --workspace @jobforge/server",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:run && npm run build && npm run check:csp"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.2.0",
    "concurrently": "^10.0.4",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
